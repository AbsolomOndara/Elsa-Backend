NODE_ENV=development
PORT=4000
DATABASE_URL=postgresql://USER:PASSWORD@HOST/DBNAME?sslmode=require
SESSION_SECRET=replace-with-a-long-random-secret
FRONTEND_URL=http://localhost:5173
# Cloudflare R2 (required for durable image uploads on Render)
R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=elsa-school-media
R2_PUBLIC_BASE_URL=
# First Director account (set these only in a secure local/Render environment)
SUPERADMIN_NAME=
SUPERADMIN_EMAIL=
SUPERADMIN_PASSWORD=
